<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox fx:id="rootPane" minHeight="700.0" minWidth="1000.0" prefHeight="780.0" prefWidth="1160.0"
      stylesheets="@pannello_admin.css" xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gruppo10.controller.PannelloAdminController">
   <children>
      <HBox styleClass="app-header">
         <children>
            <Label styleClass="brand-mark" text="TK" />
            <Label styleClass="brand-name" text="The Knife" />
            <Label styleClass="header-section" text="/  Pannello server" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="9.0" styleClass="server-status-strip">
               <children>
                  <Circle fx:id="serverStatusDot" radius="6.0" styleClass="status-dot,status-dot-idle" />
                  <Label fx:id="serverStatusLabel" styleClass="small-muted" text="Server non avviato" />
               </children>
            </HBox>
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="18.0">
               <padding><Insets bottom="26.0" left="30.0" right="30.0" top="24.0" /></padding>
               <children>
                  <HBox spacing="24.0">
                     <children>
                        <VBox minWidth="330.0" prefWidth="350.0" spacing="18.0" styleClass="hero-panel">
                           <children>
                              <Label styleClass="brand-mark" text="DB" />
                              <Label styleClass="hero-title" text="Database &amp;&#10;Server" wrapText="true" />
                              <Label styleClass="subtitle" text="Configura PostgreSQL e pubblica i servizi RMI dell’applicazione." wrapText="true" />

                              <VBox spacing="11.0" styleClass="architecture-card">
                                 <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0" /></padding>
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="architecture-node">
                                       <children>
                                          <Label styleClass="node-icon" text="PG" />
                                          <VBox spacing="2.0">
                                             <children><Label styleClass="node-title" text="PostgreSQL" /><Label styleClass="small-muted" text="Dati e persistenza" /></children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="flow-arrow" text="↓" />
                                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="architecture-node">
                                       <children>
                                          <Label styleClass="node-icon" text="RMI" />
                                          <VBox spacing="2.0">
                                             <children><Label styleClass="node-title" text="Servizi remoti" /><Label styleClass="small-muted" text="Porta 1099" /></children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="flow-arrow" text="↓" />
                                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="architecture-node">
                                       <children>
                                          <Label styleClass="node-icon" text="APP" />
                                          <VBox spacing="2.0">
                                             <children><Label styleClass="node-title" text="Client The Knife" /><Label styleClass="small-muted" text="Pronto a connettersi" /></children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="security-card">
                                 <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0" /></padding>
                                 <children>
                                    <Label styleClass="node-icon" text="✓" />
                                    <VBox spacing="2.0">
                                       <children>
                                          <Label styleClass="card-title" text="Configurazione locale" />
                                          <Label styleClass="small-muted" text="Le credenziali restano sul server." wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <VBox spacing="16.0" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox spacing="17.0" styleClass="content-card">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="13.0">
                                       <children>
                                          <Label styleClass="section-icon-box,section-icon" text="DB" />
                                          <VBox spacing="3.0">
                                             <children>
                                                <Label styleClass="section-title" text="Configurazione database" />
                                                <Label styleClass="subtitle" text="Inserisci i parametri della tua istanza PostgreSQL" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>

                                    <GridPane hgap="16.0" vgap="13.0">
                                       <columnConstraints><ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" /><ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" /></columnConstraints>
                                       <children>
                                          <VBox spacing="6.0">
                                             <children><Label styleClass="field-label" text="HOST" /><TextField fx:id="hostField" promptText="localhost" styleClass="admin-field" text="localhost" /></children>
                                          </VBox>
                                          <VBox spacing="6.0" GridPane.columnIndex="1">
                                             <children><Label styleClass="field-label" text="PORTA" /><TextField fx:id="portaField" promptText="5432" styleClass="admin-field" text="5432" /></children>
                                          </VBox>
                                          <VBox spacing="6.0" GridPane.rowIndex="1">
                                             <children><Label styleClass="field-label" text="NOME DATABASE" /><TextField fx:id="dbField" promptText="TheKnife" styleClass="admin-field" text="TheKnife" /></children>
                                          </VBox>
                                          <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                             <children><Label styleClass="field-label" text="USERNAME" /><TextField fx:id="usernameField" promptText="postgres" styleClass="admin-field" text="postgres" /></children>
                                          </VBox>
                                          <VBox spacing="6.0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                             <children><Label styleClass="field-label" text="PASSWORD" /><PasswordField fx:id="passwordField" promptText="Password PostgreSQL" styleClass="admin-field" text="Mattia2004" /></children>
                                          </VBox>
                                       </children>
                                    </GridPane>

                                    <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="status-card">
                                       <children>
                                          <Circle fx:id="databaseStatusDot" radius="7.0" styleClass="status-dot,status-dot-idle" />
                                          <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label fx:id="databaseStatusLabel" styleClass="status-title" text="Database non configurato" />
                                                <Label fx:id="databaseStatusDetail" styleClass="small-muted" text="Inserisci i parametri e avvia la connessione" wrapText="true" />
                                             </children>
                                          </VBox>
                                          <Label fx:id="databaseStatusIcon" styleClass="status-icon" text="○" />
                                       </children>
                                    </HBox>
                                    <Button fx:id="btnConnetti" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                            onAction="#connettiDB" styleClass="outline-button" text="Connetti al database" />
                                 </children>
                              </VBox>

                              <VBox spacing="13.0" styleClass="content-card">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="13.0">
                                       <children>
                                          <Label styleClass="section-icon-box,section-icon" text="RMI" />
                                          <VBox spacing="3.0">
                                             <children><Label styleClass="section-title" text="Avvio server" /><Label styleClass="subtitle" text="Pubblica i servizi remoti per il client" /></children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="server-ready-card">
                                       <children>
                                          <Label styleClass="node-icon" text="1099" />
                                          <VBox spacing="2.0">
                                             <children><Label styleClass="card-title" text="Registro RMI locale" /><Label styleClass="small-muted" text="Il client userà localhost:1099" /></children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <Button fx:id="btnAvvia" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                            onAction="#avviaServer" styleClass="primary-button" text="Avvia server" />
                                    <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="helper-text"
                                           text="Prima configura il database, poi avvia i servizi." />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="footer-bar">
                     <children>
                        <Label styleClass="footer-icon" text="✦" />
                        <Label fx:id="footerStatusLabel" styleClass="small-muted" text="Configura il database e avvia il server per iniziare." wrapText="true" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="footer-badge" text="THE KNIFE SERVER" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
