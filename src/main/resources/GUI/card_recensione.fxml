                  <Font size="15.0" />
               </font>
               <VBox.margin>
                  <Insets left="30.0" top="8.0" />
               </VBox.margin>
            </Text>
            <Text fx:id="txtTesto" strokeType="OUTSIDE" strokeWidth="0.0" text="testo recensione" wrappingWidth="549.341796875">
