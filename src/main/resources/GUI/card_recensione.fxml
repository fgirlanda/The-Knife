         <children>
            <Button fx:id="btnModifica" alignment="TOP_LEFT" mnemonicParsing="false"  text="Modifica" textAlignment="CENTER" />
            <Button fx:id="btnRimuovi" alignment="TOP_LEFT" mnemonicParsing="false" onAction="#rimuovi" text="Rimuovi" textAlignment="CENTER" />
            <Button fx:id="btnRispondi" alignment="TOP_LEFT" mnemonicParsing="false" onAction="#rispondi" text="Rispondi" textAlignment="CENTER" />
         </children>
