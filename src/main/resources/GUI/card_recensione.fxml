                  <Font size="15.0" />
               </font>
               <VBox.margin>
                  <Insets left="30.0" top="10.0" />
               </VBox.margin>
            </Text>
            <Text fx:id="txtStelle" strokeType="OUTSIDE" strokeWidth="0.0" text="stelle" wrappingWidth="160.40185546875">
