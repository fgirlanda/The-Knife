<HBox fx:id="card" alignment="BOTTOM_RIGHT" prefWidth="760.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gruppo10.controller.CardRecensioneController">
   <children>
      <VBox prefHeight="121.0" prefWidth="690.0">
         <children>
            <Text fx:id="txtCliente" strokeType="OUTSIDE" strokeWidth="0.0" text="Nome cliente" wrappingWidth="240.33740234375">
