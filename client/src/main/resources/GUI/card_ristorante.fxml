<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<HBox fx:id="card" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308"
      minHeight="164.0" prefHeight="164.0" prefWidth="1010.0" spacing="18.0" styleClass="restaurant-card"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gruppo10.controller.CardRistoranteController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="18.0" top="10.0" />
   </padding>
   <cursor><Cursor fx:constant="HAND" /></cursor>
   <children>
      <ImageView fx:id="imgRistorante" fitHeight="144.0" fitWidth="235.0" pickOnBounds="true" preserveRatio="false" />
      <VBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
         <children>
            <Text fx:id="txtNomeRistorante" text="Nome ristorante" wrappingWidth="590.0" />
            <Text fx:id="txtRecensioni" text="4,7 ★ (186 recensioni)" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Text fx:id="txtTipoCucina" text="Tipo cucina" />
                  <Label styleClass="muted" text="•" />
                  <Text fx:id="txtPrezzo" text="€€" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label styleClass="info-chip" text="Scopri il locale" />
                  <Label styleClass="info-chip" text="Recensioni verificate" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <Label style="-fx-font-size: 27px; -fx-text-fill: #315f38;" text="›" />
   </children>
</HBox>
