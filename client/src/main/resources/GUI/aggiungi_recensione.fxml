<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="500.0" prefWidth="590.0" styleClass="dialog-shell"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gruppo10.controller.AggiungiRecensioneController">
   <fx:define><ToggleGroup fx:id="stelleGroup" /></fx:define>
   <children>
      <VBox spacing="15.0" styleClass="dialog-card" VBox.vgrow="ALWAYS">
         <children>
            <Label styleClass="page-title" text="Scrivi una recensione" />
            <Text fx:id="txtNomeRistorante" style="-fx-fill: #315f38; -fx-font-size: 17px; -fx-font-weight: bold;" text="Nome ristorante" />
            <Label styleClass="field-caption" text="LA TUA VALUTAZIONE" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <RadioButton fx:id="radioStella1" styleClass="rating-choice" text="★" toggleGroup="$stelleGroup" />
                  <RadioButton fx:id="radioStella2" styleClass="rating-choice" text="★★" toggleGroup="$stelleGroup" />
                  <RadioButton fx:id="radioStella3" styleClass="rating-choice" text="★★★" toggleGroup="$stelleGroup" />
                  <RadioButton fx:id="radioStella4" styleClass="rating-choice" text="★★★★" toggleGroup="$stelleGroup" />
                  <RadioButton fx:id="radioStella5" selected="true" styleClass="rating-choice" text="★★★★★" toggleGroup="$stelleGroup" />
               </children>
            </HBox>
            <Label styleClass="field-caption" text="RACCONTA LA TUA ESPERIENZA" />
            <TextArea fx:id="txtTesto" prefHeight="185.0" promptText="Cosa ti è piaciuto? Come sono stati il servizio e i piatti?" wrapText="true" />
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="btnAnnulla" mnemonicParsing="false" onAction="#chiudi" text="Annulla" />
                  <Button fx:id="btnInvia" disable="true" mnemonicParsing="false" onAction="#aggiungiRecensione" text="Pubblica recensione" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
