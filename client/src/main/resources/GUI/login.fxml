<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="650.0" prefWidth="980.0" styleClass="login-shell"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gruppo10.controller.LoginController">
   <children>
      <StackPane prefWidth="470.0" styleClass="login-visual" HBox.hgrow="ALWAYS">
         <children>
            <VBox spacing="8.0" styleClass="login-overlay">
               <children>
                  <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Il tavolo giusto ti aspetta." />
                  <Label maxWidth="350.0" text="Scopri ristoranti, salva i tuoi preferiti e condividi la tua esperienza." wrapText="true" />
               </children>
            </VBox>
         </children>
      </StackPane>
      <VBox prefWidth="470.0" styleClass="login-card">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="brand-mark" text="TK" />
                  <Label styleClass="brand-name" text="The Knife" />
               </children>
            </HBox>
            <Region prefHeight="8.0" />
            <Label styleClass="page-title" text="Bentornato!" />
            <Label styleClass="muted" text="Accedi per continuare" />
            <VBox spacing="7.0">
               <children>
                  <Label styleClass="field-caption" text="USERNAME" />
                  <TextField fx:id="usernameField" prefHeight="42.0" promptText="Inserisci il tuo username" />
               </children>
            </VBox>
            <VBox spacing="7.0">
               <children>
                  <Label styleClass="field-caption" text="PASSWORD" />
                  <PasswordField fx:id="passwordField" prefHeight="42.0" promptText="Inserisci la password" />
               </children>
            </VBox>
            <Label fx:id="loginStatus" styleClass="status-error" wrapText="true" />
            <Button fx:id="btnLogin" defaultButton="true" disable="true" maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false" onAction="#provaLogin" prefHeight="42.0" text="Accedi" />
            <HBox alignment="CENTER" spacing="7.0">
               <children>
                  <Label styleClass="muted" text="Non hai un account?" />
                  <Button fx:id="btnRegistrati" mnemonicParsing="false" onAction="#apriRegistrazione"
                          style="-fx-padding: 6 12 6 12;" text="Registrati" />
               </children>
            </HBox>
            <Separator />
            <Label styleClass="section-title" text="Esplora senza registrarti" />
            <Label styleClass="muted" text="Indicaci da dove vuoi iniziare." />
            <TextField fx:id="indirizzoField" prefHeight="42.0" promptText="Inserisci una località o un indirizzo" />
            <Button fx:id="btnContinua" disable="true" maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false" onAction="#continuaSenzaRegistrarti" prefHeight="42.0" text="Continua" />
         </children>
      </VBox>
   </children>
</HBox>
