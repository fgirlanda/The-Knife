<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="820.0" prefWidth="1120.0" styleClass="detail-shell" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gruppo10.controller.PaginaRistoranteController">
   <children>
      <HBox styleClass="app-header">
         <children>
            <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
               <image><Image url="@../images/the-knife-logo.png" /></image>
            </ImageView>
            <Label styleClass="brand-name" text="The Knife" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnIndietro" mnemonicParsing="false" onAction="#tornaIndietro" text="←  Indietro" />
         </children>
      </HBox>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="22.0">
               <padding>
                  <Insets bottom="30.0" left="34.0" right="34.0" top="24.0" />
               </padding>
               <children>
                  <HBox spacing="28.0">
                     <children>
                        <ImageView fx:id="imgRistorante" fitHeight="335.0" fitWidth="465.0" pickOnBounds="true" preserveRatio="false" />
                        <VBox styleClass="detail-photo-frame" />
                        <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label fx:id="txtNomeRistorante" styleClass="detail-name" text="Nome ristorante" wrapText="true" HBox.hgrow="ALWAYS" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnPreferiti" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#gestisciPreferiti" style="-fx-background-color: transparent; -fx-padding: 8;">
                                       <graphic>
                                          <ImageView fx:id="imagePreferiti" fitHeight="27.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                             <image><Image url="@/images/cuore_vuoto.png" /></image>
                                          </ImageView>
                                       </graphic>
                                    </Button>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label styleClass="rating-text" text="★" />
                                    <Label fx:id="txtMediaRec" styleClass="rating-text" text="4,7 (186 recensioni)" />
                                    <Label styleClass="muted" text="•" />
                                    <Label fx:id="txtPrezzo" styleClass="muted" text="€€" />
                                 </children>
                              </HBox>
                              <HBox spacing="8.0">
                                 <children>
                                    <Label styleClass="info-chip" text="Locale selezionato" />
                                    <Label styleClass="info-chip" text="Recensioni verificate" />
                                 </children>
                              </HBox>
                              <VBox spacing="4.0" styleClass="restaurant-summary">
                                 <children>
                                    <Label styleClass="field-caption" text="DOVE SI TROVA" />
                                    <Label fx:id="txtIndirizzo" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Indirizzo" wrapText="true" />
                                    <Label fx:id="txtPaese" styleClass="muted" text="Città" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" styleClass="description-card" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="section-title" text="Descrizione" />
                                    <Text fx:id="txtDescrizione" lineSpacing="4.0" text="Descrizione del ristorante" wrappingWidth="460.0" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <VBox spacing="3.0">
                           <children>
                              <Label styleClass="section-title" text="Recensioni dei clienti" />
                              <Label styleClass="muted" text="Esperienze e opinioni della community" />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAggiungiRecensione" mnemonicParsing="false" onAction="#aggiungiRecensione" text="Scrivi una recensione" />
                     </children>
                  </HBox>
                  <VBox fx:id="contenitoreTessere" styleClass="cards-list" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
