<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ToggleGroup?>

<VBox alignment="CENTER" prefHeight="235.0" prefWidth="294.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gruppo10.client.controller.TestController">
   <children>
      <fx:define>
         <ToggleGroup fx:id="ruoloGroup"/>
      </fx:define>
      <Label text="Seleziona il ruolo:">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" spacing="10.0">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <children>
            <RadioButton fx:id="radioCliente" toggleGroup="${ruoloGroup}" mnemonicParsing="false" prefHeight="27.0" prefWidth="180.0" text="CLIENTE">
               <font>
                  <Font size="18.0" />
               </font>
            </RadioButton>
            <RadioButton fx:id="radioRistoratore" toggleGroup="${ruoloGroup}" mnemonicParsing="false" prefHeight="27.0" prefWidth="180.0" text="RISTORATORE">
               <font>
                  <Font size="18.0" />
               </font>
            </RadioButton>
            <RadioButton fx:id="radioNonRegistrato" toggleGroup="${ruoloGroup}" mnemonicParsing="false" prefHeight="27.0" prefWidth="180.0" text="NON REGISTRATO">
               <font>
                  <Font size="18.0" />
               </font>
            </RadioButton>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </VBox>
      <Button fx:id="btnAccedi" mnemonicParsing="false" onAction="#accedi" text="Accedi">
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
</VBox>
