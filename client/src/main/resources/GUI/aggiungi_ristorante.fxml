<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="740.0" prefWidth="760.0" styleClass="dialog-shell"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gruppo10.controller.AggiungiRistoranteController">
   <fx:define>
      <ToggleGroup fx:id="deliveryGroup" />
      <ToggleGroup fx:id="prenotazioneGroup" />
      <ToggleGroup fx:id="prezzoGroup" />
   </fx:define>
   <children>
      <VBox spacing="14.0" styleClass="dialog-card" VBox.vgrow="ALWAYS">
         <children>
            <Label styleClass="page-title" text="Aggiungi un ristorante" />
            <Label styleClass="muted" text="Inserisci le informazioni principali della tua attività." />
            <GridPane hgap="18.0" vgap="13.0">
               <children>
                  <VBox spacing="5.0" GridPane.columnSpan="2">
                     <children><Label styleClass="field-caption" text="NOME DEL RISTORANTE" /><TextField fx:id="nomeRistoranteField" promptText="Es. Osteria del Borgo" /></children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                     <children><Label styleClass="field-caption" text="INDIRIZZO" /><TextField fx:id="indirizzoField" promptText="Via, numero civico, città" /></children>
                  </VBox>
                  <VBox spacing="7.0" GridPane.rowIndex="2">
                     <children>
                        <Label styleClass="field-caption" text="DELIVERY" />
                        <HBox spacing="18.0"><children>
                           <RadioButton fx:id="radioDeliverySi" selected="true" text="Disponibile" toggleGroup="$deliveryGroup" />
                           <RadioButton fx:id="radioDeliveryNo" text="Non disponibile" toggleGroup="$deliveryGroup" />
                        </children></HBox>
                     </children>
                  </VBox>
                  <VBox spacing="7.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <children>
                        <Label styleClass="field-caption" text="PRENOTAZIONE ONLINE" />
                        <HBox spacing="18.0"><children>
                           <RadioButton fx:id="radioPrenotazioneSi" selected="true" text="Disponibile" toggleGroup="$prenotazioneGroup" />
                           <RadioButton fx:id="radioPrenotazioneNo" text="Non disponibile" toggleGroup="$prenotazioneGroup" />
                        </children></HBox>
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.rowIndex="3">
                     <children><Label styleClass="field-caption" text="TIPO DI CUCINA" /><ComboBox fx:id="comboCucina" maxWidth="1.7976931348623157E308" promptText="Seleziona una cucina" /></children>
                  </VBox>
                  <VBox spacing="7.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <Label styleClass="field-caption" text="FASCIA DI PREZZO" />
                        <HBox spacing="13.0"><children>
                           <RadioButton fx:id="radioPrezzo1" selected="true" text="€" toggleGroup="$prezzoGroup" />
                           <RadioButton fx:id="radioPrezzo2" text="€€" toggleGroup="$prezzoGroup" />
                           <RadioButton fx:id="radioPrezzo3" text="€€€" toggleGroup="$prezzoGroup" />
                           <RadioButton fx:id="radioPrezzo4" text="€€€€" toggleGroup="$prezzoGroup" />
                        </children></HBox>
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                     <children><Label styleClass="field-caption" text="DESCRIZIONE" /><TextArea fx:id="txtDescrizione" prefHeight="190.0" promptText="Racconta la cucina, l’atmosfera e ciò che rende speciale il tuo ristorante…" wrapText="true" /></children>
                  </VBox>
               </children>
            </GridPane>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="btnAnnulla" mnemonicParsing="false" onAction="#chiudi" text="Annulla" />
                  <Button fx:id="btnAggiungiRistorante" disable="true" mnemonicParsing="false" onAction="#aggiungiRistorante" text="Aggiungi ristorante" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
