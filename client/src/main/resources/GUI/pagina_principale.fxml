<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="780.0" prefWidth="1165.0" styleClass="app-shell" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gruppo10.controller.PaginaPrincipaleController">
   <children>
      <HBox styleClass="app-header">
         <children>
            <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
               <image><Image url="@../images/the-knife-logo.png" /></image>
            </ImageView>
            <Label styleClass="brand-name" text="The Knife" />
            <Region prefWidth="14.0" />
            <HBox alignment="CENTER" styleClass="search-box" HBox.hgrow="ALWAYS">
               <children>
                  <TextField fx:id="ricercaField" maxWidth="1.7976931348623157E308" prefWidth="460.0" promptText="Cerca ristorante, cucina o località…" styleClass="search-field" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnCerca" mnemonicParsing="false" onAction="#applicaFiltri" styleClass="search-button" text="⌕" />
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnRegistratiProfilo" mnemonicParsing="false" onAction="#gestisciBottoneUtente" text="Profilo" />
         </children>
      </HBox>
      <VBox spacing="16.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="18.0" left="32.0" right="32.0" top="22.0" />
         </padding>
         <children>
            <VBox spacing="5.0" styleClass="hero-panel">
               <children>
                  <Label styleClass="eyebrow" text="SCOPRI • SCEGLI • PRENOTA" />
                  <Label styleClass="page-title" text="Dove vuoi mangiare oggi?" />
                  <Label styleClass="muted" text="Trova il locale giusto filtrando per cucina, prezzo e servizi." />
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" styleClass="filter-bar">
               <children>
                  <ComboBox fx:id="comboFiltroRecensioni" maxWidth="1.7976931348623157E308" promptText="Valutazione" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="comboFiltroCucina" maxWidth="1.7976931348623157E308" promptText="Cucina" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="comboFiltroPrezzo" maxWidth="1.7976931348623157E308" promptText="€ Prezzo" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="comboFiltroDelivery" maxWidth="1.7976931348623157E308" promptText="Delivery" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="comboFiltroPrenotazione" maxWidth="1.7976931348623157E308" promptText="Prenotazione" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="comboFiltroDistanza" maxWidth="1.7976931348623157E308" promptText="Distanza" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnApplicaFiltri" mnemonicParsing="false" onAction="#applicaFiltri" text="Applica filtri" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="section-title" text="Ristoranti consigliati" />
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="contenitoreTessere" styleClass="cards-list" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</VBox>
