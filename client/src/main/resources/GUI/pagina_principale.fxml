<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="780.0" prefWidth="1100.0" styleClass="app-shell"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gruppo10.controller.PaginaPrincipaleController">
   <children>
      <HBox styleClass="app-header">
         <children>
            <Label styleClass="brand-mark" text="TK" />
            <Label styleClass="brand-name" text="The Knife" />
            <Region prefWidth="14.0" />
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
               <children>
                  <TextField fx:id="ricercaField" maxWidth="520.0" prefWidth="460.0"
                             promptText="Cerca ristorante, cucina o località…" styleClass="search-field" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnCerca" mnemonicParsing="false" onAction="#applicaFiltri"
                          styleClass="search-button" text="⌕" />
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnRegistratiProfilo" mnemonicParsing="false" onAction="#gestisciBottoneUtente" text="Profilo" />
         </children>
      </HBox>
      <VBox spacing="16.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="18.0" left="32.0" right="32.0" top="22.0" />
         </padding>
         <children>
            <VBox spacing="5.0" styleClass="hero-panel">
               <children>
                  <Label styleClass="eyebrow" text="SCOPRI • SCEGLI • PRENOTA" />
                  <Label styleClass="page-title" text="Dove vuoi mangiare oggi?" />
                  <Label styleClass="muted" text="Trova il locale giusto filtrando per cucina, prezzo e servizi." />
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" styleClass="filter-bar">
               <children>
                  <ComboBox fx:id="comboFiltroRecensioni" promptText="★ Valutazione" />
                  <ComboBox fx:id="comboFiltroCucina" promptText="Cucina" />
                  <ComboBox fx:id="comboFiltroPrezzo" promptText="€ Prezzo" />
                  <ComboBox fx:id="comboFiltroDelivery" promptText="Delivery" />
                  <ComboBox fx:id="comboFiltroPrenotazione" promptText="Prenotazione" />
                  <ComboBox fx:id="comboFiltroDistanza" promptText="Distanza" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnApplicaFiltri" mnemonicParsing="false" onAction="#applicaFiltri" text="Applica filtri" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="section-title" text="Ristoranti consigliati" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="muted" text="Risultati ordinati per rilevanza" />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="contenitoreTessere" styleClass="cards-list" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</VBox>
